# Langfuse 自托管环境变量：复制为 .env 后替换所有 CHANGE_ME
# 生成密钥：openssl rand -base64 32 / openssl rand -hex 32

NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=CHANGE_ME_base64_32
SALT=CHANGE_ME_base64_32
# 必须是 64 位十六进制
ENCRYPTION_KEY=CHANGE_ME_64_HEX

POSTGRES_PASSWORD=CHANGE_ME_postgres
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse
REDIS_PASSWORD=CHANGE_ME_redis
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio

# 首次启动自动创建的组织/项目/管理员（登录后可在页面再建项目）
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME_langfuse_admin
