# 复制为 .env 后填写。 skeleton 可在无 Key 情况下运行（LLM_MOCK=true 走内置 mock）

# --- 应用 ---
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8100
# 启动时自动建表/迁移；K8s 多副本部署时设为 false，由 initContainer 执行一次
INIT_DB_ON_STARTUP=true

# --- 数据源（只读账号，模拟用户身份透传） ---
DATA_SOURCE_URL=mysql+pymysql://datapro_ro:CHANGE_ME@127.0.0.1:3306/dwd_shop
EXEC_MAX_CONCURRENCY=20
EXEC_ROW_LIMIT=200
EXEC_TIMEOUT_MS=10000
# 扫描量预估拦截（A09）：EXPLAIN 预估超过该行数转人工；0 关闭
SCAN_GUARD_ENABLED=true
MAX_SCAN_ROWS=2000000
# 大结果集导出（B13/F11）：审批通过后最多导出行数
EXPORT_MAX_ROWS=100000

# --- 元数据/审计库（DataPro 自有业务库） ---
APP_DATABASE_URL=mysql+pymysql://datapro:CHANGE_ME@127.0.0.1:3306/datapro

# --- 先知采集：ODS 写入专用账号（与只读查询账号物理隔离） ---
# 该账号仅授 dwd_shop.ods_xianzhi_info_analysis 的 SELECT/INSERT/UPDATE，无 DDL、无 dwd_* 写权限。
# CHANGE_ME 是占位符，生产必须由运维注入并轮换；源码与模板中禁止出现真实口令。
# 浏览器二进制另需执行一次：python -m playwright install chromium
ODS_WRITER_URL=mysql+pymysql://dp_ods_writer:CHANGE_ME@127.0.0.1:3306/dwd_shop

# --- 数据源库（来源/数据集/字段映射/批次/坏行） ---
# 留空则按业务库名推导为 <业务库>_source；生产建议显式指定并单独授权
SOURCE_DATABASE_URL=mysql+pymysql://datapro:CHANGE_ME@127.0.0.1:3306/datapro_source
# 库不存在时是否自动创建（需账号有全局 CREATE 权限，生产保持 false 由 DBA 预建）
SOURCE_DB_AUTO_CREATE=false

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
# 每用户每分钟请求上限（B14/E007）；0 表示关闭限流
RATE_LIMIT_PER_MINUTE=30

# --- 限定范围缓存（U-B03）：只缓存意图分类与口径问答，取数结果永不缓存 ---
# mock 模式下自动跳过；Redis 不可用时降级进程内存
QUERY_CACHE_ENABLED=true
CACHE_TTL_INTENT=21600
CACHE_TTL_META=1800
CACHE_TTL_NEGATIVE=120

# --- 数据生命周期（worker 每日 06:30 分批删除，0 表示不清理） ---
AUDIT_RETENTION_DAYS=180
QUERY_RETENTION_DAYS=365
MESSAGE_RETENTION_DAYS=365

# --- 配置域存储（0016） ---
# db=业务库 config_doc（默认，多实例强一致）；file=仅本地 JSON（回滚开关）
CONFIG_STORE=db
CONFIG_STORE_CACHE_TTL=1.0

# 可观测（可选）：PUBLIC_KEY/SECRET_KEY 都填了才上报，否则 no-op
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- LLM（openai 兼容协议） ---
LLM_MOCK=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_FALLBACK_MODEL=

# --- 图片理解（视觉模型）---
# 主模型不接受图片：图片必须先经视觉模型转成文字描述，才能进入问答/取数链路。
# 关掉后对图片只做诚实说明（不假装能看），不报错。
VISION_ENABLED=true
VISION_MODEL=deepseek-v4-flash-vision-exp
# 空 = 复用上面 LLM 注册表默认项的 base_url 与 Key（换 Key 不用改两处）
VISION_BASE_URL=
VISION_API_KEY_REF=
VISION_TIMEOUT=30
VISION_MAX_IMAGES=3
VISION_MAX_BYTES=10485760
# 管理端模型条目不存明文 Key，只存引用（env:变量名 / file:路径#变量 / kms://路径#字段）。
# 引用解析失败按「未配置」处理；轮换密钥最多 SECRET_REF_CACHE_TTL 秒生效。
SECRET_REF_CACHE_TTL=60
# KMS（可选）：配置后 kms:// 引用可用（内置 Vault KV 后端；也可 register_kms_backend 接入云厂商）
# SECRET_KMS_URL=https://vault.example.com:8200
# SECRET_KMS_MOUNT=secret
# SECRET_KMS_KV_VERSION=2
# SECRET_KMS_TOKEN_ENV=VAULT_TOKEN

# --- 认证（B12） ---
# Token 签名密钥：生产必须替换为强随机值
AUTH_SECRET=CHANGE_ME
AUTH_TOKEN_TTL_HOURS=12
# 首次启动初始化的演示账号密码（仅 dev，生产请改密或接 SSO）
AUTH_SEED_ADMIN_PASSWORD=admin123
AUTH_SEED_USER_PASSWORD=user123

# --- 降级开关（Runbook §3） ---
FEATURE_DATA_PRO_ENABLED=true
FEATURE_INSPECTION_ENABLED=true
# 巡检失败告警 webhook（企业 IM 机器人地址，留空只记日志）
INSPECTION_WEBHOOK_URL=
# 平台类型：auto | feishu | dingtalk | wecom | generic（auto 按 URL 识别，识别不出按飞书）
INSPECTION_WEBHOOK_TYPE=auto
# 钉钉加签 / 飞书签名密钥（可空）
INSPECTION_WEBHOOK_SECRET=
RECALL_DEGRADED_MODE=auto

# --- 返回层脱敏（S04） ---
MASK_ENABLED=true
# 追加需要整列打码的列名关键词，逗号分隔（内置已含 phone/mobile/id_card/bank_card/email 等）
MASK_EXTRA_COLUMNS=

# --- 向量召回（A05，默认关闭）---
# 编码器：auto=有本地 IR 用本地，否则复用 API embedding；local=只本地；api=只 API
# 走 api 时只需要配好下方 EMBED_* 三项，不需要 openvino/transformers
VECTOR_RECALL_ENABLED=false
VECTOR_ENCODER=auto
VECTOR_IR_PATH=
VECTOR_TOKENIZER=BAAI/bge-small-zh-v1.5
# 句向量池化：cls（bge 等中文模型约定）| mean；选错不报错，只让相似度整体偏移
VECTOR_POOLING=cls
VECTOR_MAX_LENGTH=128
VECTOR_TOP_K=3
VECTOR_MIN_SCORE=0.35
# 向量路单独超时（秒）：首次编码可能几秒，别用 TIMEOUT_RECALL 掐掉
VECTOR_TIMEOUT=5
# 向量缓存（0021）：落 meta_embedding 复用，避免每次重启重编码上百份元数据文档
VECTOR_CACHE_ENABLED=true
# 后端：memory（默认，进程内）| milvus
VECTOR_BACKEND=memory
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=datapro_meta

# --- 文档知识库 RAG（0020，默认开启）---
# 检索不到高于阈值的内容时回答「未收录」，不注入弱相关片段
DOC_RAG_ENABLED=true
DOC_RAG_TOP_K=4
DOC_RAG_MIN_SCORE=0.35
DOC_RAG_LEXICAL_WEIGHT=0.25
DOC_RAG_MAX_CONTEXT_CHARS=4000
DOC_CHUNK_SIZE=360
DOC_CHUNK_OVERLAP=80

# --- Embedding（API，OpenAI 兼容 /embeddings）---
# 三项齐备才启用；缺任一项自动降级为词法检索（可正常问答，只是召回面变窄）
# 密钥只走引用，不写明文：ENV:/FILE:/KMS:，与 LLM_API_KEY_REF 同一套解析
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY_REF=
EMBED_DIM=1024
EMBED_BATCH_SIZE=16
EMBED_TIMEOUT=10
EMBED_MAX_RETRIES=3

# --- 监控（I03）：/metrics 文本端点 ---
METRICS_ENABLED=true

# --- 意图识别（B04）：LLM 分类优先，规则兜底；LLM_MOCK=true 时不调用模型 ---
INTENT_LLM_ENABLED=true
