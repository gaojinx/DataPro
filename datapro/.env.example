# 复制为 .env 后填写。 skeleton 可在无 Key 情况下运行（LLM_MOCK=true 走内置 mock）

# --- 应用 ---
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8100

# --- 数据源（只读账号，模拟用户身份透传） ---
DATA_SOURCE_URL=mysql+pymysql://datapro_ro:CHANGE_ME@127.0.0.1:3306/dwd_shop
EXEC_MAX_CONCURRENCY=20
EXEC_ROW_LIMIT=200
EXEC_TIMEOUT_MS=10000

# --- 元数据/审计库（DataPro 自有业务库） ---
APP_DATABASE_URL=mysql+pymysql://datapro:CHANGE_ME@127.0.0.1:3306/datapro

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- LLM（openai 兼容协议） ---
LLM_MOCK=true
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=

# --- 降级开关（Runbook §3） ---
FEATURE_DATA_PRO_ENABLED=true
FEATURE_INSPECTION_ENABLED=true
RECALL_DEGRADED_MODE=auto
